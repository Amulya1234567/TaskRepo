# Default ignored files
### Ignore target (build) directories ###
target/
!**/src/main/**/target/
!**/src/test/**/target/

### Ignore build output directories ###
build/
!**/src/main/**/build/
!**/src/test/**/build/

### Ignore Maven Wrapper Files (except required ones) ###
.mvn/
!mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### Visual Studio Code ###
.vscode/

### OS-specific files ###
.DS_Store
Thumbs.db

### Logs and Temporary Files ###
*.log
hs_err_pid*
*.swp

